#!/bin/bash
#SBATCH -J anyio_sm
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu
#SBATCH -q gpu
#SBATCH --gres=gpu:a30:1
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=48G
#SBATCH -t 01:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/anyiosm_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/anyiosm_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
SMOKE=1 D=64 H=4 L=2 EP=1 MIX=4 NSEED=1 $PY pretrain/run_anyio_v2.py
echo SMOKE_DONE
