#!/bin/bash
#SBATCH -J bakeoff_a
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 8 --mem=64G -t 10:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/bakeoff_a_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/bakeoff_a_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
SEED0=0 NSEED=2 KC=256 D=512 H=8 L=8 EP=10 MIX=4 SPLIT=96 LOUTMAX=64 EVALMAX=3000 BS=256 $PY pretrain/run_bakeoff_v2.py
echo BAKEOFF_a_DONE
