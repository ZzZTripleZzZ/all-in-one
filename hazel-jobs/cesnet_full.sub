#!/bin/bash
#SBATCH -J cesnet_full
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 8 --mem=64G -t 08:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/cesnet_full_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/cesnet_full_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
D=512 H=8 L=8 EP=8 NSEED=2 SPLIT=168 HMAX=24 STRIDE=24 EVALMAX=3000 BS=128 $PY pretrain/run_cesnet_v2.py
echo CESNET_FULL_DONE
