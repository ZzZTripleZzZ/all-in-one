#!/bin/bash
#SBATCH -J bf_scale
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 4 --mem=64G -t 06:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/bfscale_%x_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/bfscale_%x_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
C=${C:?}   # prior months in the pretraining corpus: 0 | 1 | 2 | 4  (eval month = 21_08, NFILE=4)
case $C in
  0) TM="";;
  1) TM="3";;
  2) TM="2,3";;
  4) TM="0,1,2,3";;
esac
EST=~/nfm/data/bf2_scale_c$C
SEED=0 USE_TIME=1 ARM=HSTU NFILE=4 TRAINMONTHS=$TM MAXJ=60000 LMAX=96 D=256 H=8 L=4 EP=30 MIX=6 STRIDE=24 QS=0.6 OUT=$EST $PY pretrain/run_backfill_model_v2.py
for RHO in 1.30 1.15 0.95; do
  echo "---- scale C=$C rho=$RHO ----"
  NFILE=4 MAXJ=60000 RHOCAP=$RHO HISTQ=0.9 MODEL_EST=$EST/hstu_q60.npz $PY pretrain/run_backfill_replay.py
done
echo BF_SCALE_${C}_DONE
