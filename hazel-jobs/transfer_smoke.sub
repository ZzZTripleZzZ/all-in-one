#!/bin/bash
#SBATCH -J tr_smoke
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 4 --mem=32G -t 01:30:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/tr_smoke_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/tr_smoke_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
CK=~/nfm/data/transfer/src_smoke.pt
echo "== smoke 1/4: pretrain (tiny) =="
MODE=pretrain SRC=cesnet,azure MAXW=15000 AZMAX=400 PSTRIDE=96 \
SEED=0 USE_TIME=1 ARM=HSTU NFILE=0 LMAX=96 D=256 H=8 L=4 EP=1 MIX=6 BS=256 \
OUT=~/nfm/data/transfer_scratchdir CKPT=$CK $PY pretrain/run_transfer_v2.py
echo "== smoke 2/4: transfer finetune (tiny budget) =="
EST=~/nfm/data/tr_smoke_transfer
MODE=transfer PREDAYS=0.25 SEED=0 CKPT=$CK \
USE_TIME=1 ARM=HSTU NFILE=0 LMAX=96 D=256 H=8 L=4 EP=2 MIX=6 STRIDE=24 QS=0.5,0.6 OUT=$EST \
$PY pretrain/run_transfer_v2.py
echo "== smoke 3/4: zeroshot =="
EST0=~/nfm/data/tr_smoke_zeroshot
MODE=zeroshot PREDAYS=0.25 SEED=0 CKPT=$CK \
USE_TIME=1 ARM=HSTU NFILE=0 LMAX=96 D=256 H=8 L=4 MIX=6 STRIDE=24 QS=0.5,0.6 OUT=$EST0 \
$PY pretrain/run_transfer_v2.py
echo "== smoke 4/4: replay (truncated) =="
MAXJ=12000 NODES=20000 HISTQ=0.9 MODEL_EST=$EST/hstu_q50.npz $PY pretrain/run_backfill_replay.py
echo TR_SMOKE_DONE
