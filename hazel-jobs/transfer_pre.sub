#!/bin/bash
#SBATCH -J tr_pre
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 8 --mem=64G -t 06:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/tr_pre_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/tr_pre_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
MODE=pretrain SRC=cesnet,azure MAXW=250000 AZMAX=6000 PSTRIDE=48 \
SEED=0 USE_TIME=1 ARM=HSTU NFILE=0 LMAX=96 D=256 H=8 L=4 EP=6 MIX=6 BS=256 \
OUT=~/nfm/data/transfer_scratchdir CKPT=~/nfm/data/transfer/src_ca.pt \
$PY pretrain/run_transfer_v2.py
echo TR_PRE_DONE
