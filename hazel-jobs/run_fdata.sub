#!/bin/bash
#SBATCH -J nfm_fdata
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu
#SBATCH -q gpu
#SBATCH --gres=gpu:a30:1
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=48G
#SBATCH -t 08:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/fdata_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/fdata_%j.err
set -e
export PYTHONNOUSERSITE=1
export HF_HOME=/share/hpcproject/zzhang66/nfm/hf_cache
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
echo "=== node/gpu ==="; hostname; nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo "=== torch ==="; $PY -c "import torch;print('torch',torch.__version__,'cuda_avail',torch.cuda.is_available(),torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"
echo "=== LINE 1: F-DATA multi-horizon forecasting ==="
K=1024 CTX=32 HMAX=16 D=256 H=4 L=4 EP=10 CHRONOS=1 $PY pretrain/run_horizon.py fdata
echo "=== LINE 1+2a: FM pipeline (forecast + failure-cls + nodecount-reg) ==="
D=256 L=4 PRE_EP=10 FT_EP=6 CHRONOS=1 $PY sft/demo_pipeline.py
echo "=== ALL DONE ==="
