#!/bin/bash
#SBATCH -J nfm_scale
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu
#SBATCH -q gpu
#SBATCH --gres=gpu:a30:1
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=48G
#SBATCH -t 06:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/scale_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/scale_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
for F in 0.25 0.5 1.0; do
  echo "########## TRAIN-FRAC=$F ##########"
  env FRAC=$F K=1024 CTX=32 HMAX=16 D=256 H=4 L=4 EP=10 CHRONOS=0 $PY pretrain/run_horizon.py fdata
done
echo ALL_DONE
