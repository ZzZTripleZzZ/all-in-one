#!/bin/bash
#SBATCH -J bakeoff_smoke
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu -q gpu --gres=gpu:a30:1
#SBATCH -N 1 -n 1 -c 8 --mem=64G -t 00:45:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/bakeoff_smoke_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/bakeoff_smoke_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
$PY -m py_compile common/nfm_v2.py pretrain/run_bakeoff_v2.py && echo "COMPILE OK"
SMOKE=1 $PY pretrain/run_bakeoff_v2.py
echo BAKEOFF_SMOKE_DONE
