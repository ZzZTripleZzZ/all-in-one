#!/bin/bash
#SBATCH -J bgl_full
#SBATCH -A hpcproject_gpu
#SBATCH -p gpu
#SBATCH -q gpu
#SBATCH --gres=gpu:a30:1
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=64G
#SBATCH -t 08:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/bgl_full_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/bgl_full_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
DATASET=BGL W=100 D=512 H=8 L=8 EP=15 NSEED=3 TOPG=10 BS=256 $PY sft/run_loganomaly.py
echo BGL_FULL_DONE
