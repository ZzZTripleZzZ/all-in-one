#!/bin/bash
#SBATCH -J bf_base
#SBATCH -A hpcproject_cpu
#SBATCH -p compute -q normal
#SBATCH -N 1 -n 1 -c 4 --mem=16G -t 02:00:00
#SBATCH -o /share/hpcproject/zzhang66/nfm/logs/bf_base_%j.out
#SBATCH -e /share/hpcproject/zzhang66/nfm/logs/bf_base_%j.err
set -e
export PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PY=/share/hpcproject/zzhang66/nfm/env/bin/python
cd /share/hpcproject/zzhang66/nfm/code
BASE=~/nfm/data/backfill_base
QS=0.6,0.9 OUT=$BASE $PY pretrain/run_backfill_baselines.py
for CAP in 20000 23000; do
  for E in tsafrir gbm_q60 gbm_q90; do
    echo "---- baseline=$E cap=$CAP ----"
    NODES=$CAP HISTQ=0.9 MODEL_EST=$BASE/$E.npz $PY pretrain/run_backfill_replay.py
  done
done
echo BF_BASELINES_DONE
